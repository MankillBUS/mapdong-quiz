{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "mapdong.com" }],
      "destination": "https://www.mapdong.com/$1",
      "permanent": true
    }
  ],
  "routes": [
    { "src": "/ads.txt",                                    "dest": "/ads.txt"                                    },
    { "src": "/robots.txt",                                 "dest": "/robots.txt"                                 },
    { "src": "/sitemap.xml",                                "dest": "/sitemap.xml"                                },
    { "src": "/polygon_cache.json",                         "dest": "/polygon_cache.json"                        },
    { "src": "/index.html",                                 "dest": "/index.html"                                 },
    { "src": "/community.html",                             "dest": "/community.html"                             },
    { "src": "/myinfo.html",                                "dest": "/myinfo.html"                                },
    { "src": "/privacy.html",                               "dest": "/privacy.html"                               },
    { "src": "/ranking.html",                               "dest": "/ranking.html"                               },
    { "src": "/debug_ranking.html",                         "dest": "/debug_ranking.html"                         },
    { "src": "/debug_auth.html",                            "dest": "/debug_auth.html"                            },
    { "src": "/naverd74e0774a3bb384baca98d24f92dfb30.html", "dest": "/naverd74e0774a3bb384baca98d24f92dfb30.html" },
    { "src": "/workmode",                                   "dest": "/gps/index.js"                               },
    { "src": "/gps/(.*)",                                   "dest": "/gps/$1"                                     },
    { "src": "/(.*)",                                       "dest": "/index.html"                                 }
  ]
}
